// Create each measure individually in Power BI Desktop. Use IDR formatting.
Net Revenue = SUM(FactOrders[net_sales])
Orders = DISTINCTCOUNT(FactOrders[receipt])
Average Order Value = DIVIDE([Net Revenue], [Orders])
Tax Collected = SUM(FactOrders[tax])
Amount Collected = SUM(FactOrders[total_amount])
Items Reported = SUM(FactOrders[item_count])
Previous Month Revenue = CALCULATE([Net Revenue], DATEADD(DimDate[date], -1, MONTH))
Previous Month Orders = CALCULATE([Orders], DATEADD(DimDate[date], -1, MONTH))
Previous Month AOV = CALCULATE([Average Order Value], DATEADD(DimDate[date], -1, MONTH))
MoM Revenue % = DIVIDE([Net Revenue] - [Previous Month Revenue], [Previous Month Revenue])
Volume Effect = IF(NOT ISBLANK([Previous Month AOV]), ([Orders] - [Previous Month Orders]) * [Previous Month AOV])
AOV Effect = IF(NOT ISBLANK([Previous Month AOV]), [Orders] * ([Average Order Value] - [Previous Month AOV]))
Outlet Rank = RANKX(ALLSELECTED(DimOutlet[outlet]), [Net Revenue], , DESC, DENSE)
Outlet Revenue Share = DIVIDE([Net Revenue], CALCULATE([Net Revenue], ALLSELECTED(DimOutlet[outlet])))
Product Basket Count = DISTINCTCOUNT(BasketMentions[receipt])
Basket Penetration = DIVIDE([Product Basket Count], [Orders])
